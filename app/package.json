{
  "name": "@fs/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && FS_SURFACE=staff vite build && FS_SURFACE=owner vite build",
    "preview": "vite preview",
    "typecheck": "s=0; for p in app worker sw node; do tsc -p tsconfig.$p.json || s=1; done; exit $s",
    "test": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@fs/contracts": "workspace:*",
    "@fs/engine": "workspace:*",
    "@fs/i18n": "workspace:*",
    "@fs/templates": "workspace:*",
    "@fs/ui": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "@pushforge/builder": "2.0.5",
    "@simplewebauthn/server": "13.3.3",
    "@tanstack/react-query": "5.104.4",
    "hono": "4.13.13",
    "i18next": "25.10.10",
    "idb": "8.0.4",
    "jsqr": "1.4.0",
    "leaflet": "1.9.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "16.6.6",
    "react-router": "7.18.4",
    "uqr": "0.1.3",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "1.0.4",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "happy-dom": "21.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  }
}
