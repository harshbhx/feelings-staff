{
  "name": "@fs/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "i18next setup, en/gu catalogs by namespace, Intl formatters (PRD 11.9).",
  "exports": {
    ".": "./src/index.ts",
    "./fonts": "./src/fonts.ts",
    "./en/*": "./en/*",
    "./gu/*": "./gu/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/noto-sans-gujarati": "5.3.0",
    "@fs/contracts": "workspace:*",
    "i18next": "25.10.10"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
